{
  "model_profiles": {
    "ox-alpha-free-high": {
      "model": "ox-alpha-free",
      "provider": "opencode-go",
      "effort": "high",
      "context_window": 1000000,
      "context_window_handout": 600000,
      "poll_interval": 10,
      "poll_tiers": [[500000, 180], [550000, 10], [-1, 3]]
    },
    "ox-alpha-free-max": {
      "model": "ox-alpha-free",
      "provider": "opencode-go",
      "effort": "max",
      "context_window": 1000000,
      "context_window_handout": 600000,
      "poll_interval": 10,
      "poll_tiers": [[500000, 180], [550000, 10], [-1, 3]]
    },
    "muse-spark-high": {
      "model": "muse-spark-1.3-contributor",
      "provider": "opencode-go",
      "effort": "high",
      "context_window": 1000000,
      "context_window_handout": 600000,
      "poll_interval": 10,
      "poll_tiers": [[500000, 180], [550000, 10], [-1, 3]]
    },
    "muse-spark-free": {
      "model": "muse-spark-1.3-contributor-free",
      "provider": "opencode",
      "effort": "high",
      "context_window": 1000000,
      "context_window_handout": 600000,
      "poll_interval": 10,
      "poll_tiers": [[500000, 180], [550000, 10], [-1, 3]]
    }
  },

  "roles": {
    "planner": {
      "model_profile": "muse-spark-high",
      "description": "Reads a design plan and the existing repo, splits the plan into an ordered task list, and assigns each task an implementation role.",
      "allowed_tools": ["Read", "Glob", "Grep", "WebFetch", "WebSearch"],
      "max_turns": 80
    },
    "trivial": {
      "model_profile": "muse-spark-high",
      "description": "testing a free model - fastest workhorse",
      "kill_pct": 90
    },
    "mechanical": {
      "model_profile": "muse-spark-high",
      "description": "Boilerplate, scaffolding, or well-precedented changes with one clear correct approach and low blast radius.",
      "kill_pct": 90
    },
    "standard": {
      "model_profile": "muse-spark-free",
      "description": "Typical feature work: moderate business logic and edge cases, bounded integration, judgment calls within a clear spec."
    },
    "complex": {
      "model_profile": "muse-spark-high",
      "description": "Nontrivial engineering: algorithmic work, tricky state or concurrency, ambiguous requirements, deep cross-subsystem integration."
    },
    "critical": {
      "model_profile": "muse-spark-high",
      "description": "High blast-radius or foundational work: security, auth, payments, data migrations, public API contracts, or architecturally significant decisions.",
      "max_budget_usd": 15
    }
  },

  "implementation_ladder": ["trivial", "mechanical", "standard", "complex", "critical"],
  "default_role": "standard",
  "escalate_on_repeated_failure": false
}
