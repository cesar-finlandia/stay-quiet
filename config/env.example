# Requirement IDs: DEP-02, DEP-RES-02 | DP-B §5.2 — checked in, NO real values.
# Copy to .env and fill; secrets are never committed (GOV-RES-02).
# See config/deploy/README.md for the full key-by-key guide.

# --- Runtime knobs (non-secret) -------------------------------------------
DEPLOY_PROVIDER=vercel
TRANSPORT=sse
THEME=minimal
API_BASE=

# --- Secrets (never defaulted, never committed) ----------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRACE_ID_SALT=

# --- Deploy provider credentials (only needed for `npm run deploy`) --------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
